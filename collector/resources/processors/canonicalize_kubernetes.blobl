let subject = this.metadata.annotations."openmeter.io/subject".or(this.metadata.name)
let billable = this.metadata.annotations."openmeter.io/billable".or("true")
let duration_seconds = (meta("schedule_interval").parse_duration() / 1000 / 1000 / 1000).round().int64()
let event_time = meta("schedule_time")

root = if $billable != "true" {
  deleted()
} else {
  {
    "id": "kubernetes-api:%s:%s".format(this.metadata.name, $event_time).hash("sha256"),
    "specversion": "1.0",
    "type": "kube-pod-exec-time",
    "source": "kubernetes-api",
    "time": $event_time,
    "subject": $subject,
    "data": this.metadata.annotations.filter(item -> item.key.has_prefix("data.openmeter.io/")).map_each_key(key -> key.trim_prefix("data.openmeter.io/")).assign({
      "pod_name": this.metadata.name,
      "pod_namespace": this.metadata.namespace,
      "duration_seconds": $duration_seconds,
      "cpu_limit": this.spec.containers.index(0).resources.limits.cpu.or(null),
      "cpu_requests": this.spec.containers.index(0).resources.requests.cpu.or(null),
      "memory_limit": this.spec.containers.index(0).resources.limits.memory.or(null),
      "memory_requests": this.spec.containers.index(0).resources.requests.memory.or(null)
    })
  }
}

root = if this == deleted() {
  deleted()
} else if !this.exists("subject") || this.subject == "" {
  throw("missing subject")
} else {
  this
}
